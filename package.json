    "test:watch": "vitest",
    "assets": "python3 tools/prep_assets.py",
    "maps": "python3 tools/gen_maps.py"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
