{
  "name": "pixelworldrpg",
  "private": true,
  "version": "0.1.0",
  "description": "Emberwake: The Last Waystone - a single-world action RPG for mobile browsers. Created by Gab.",
  "type": "module",
  "license": "MIT",
  "author": "Gab",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
